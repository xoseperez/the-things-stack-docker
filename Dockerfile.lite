# check=skip=InvalidDefaultArgInFrom
# The upstream version has no default here: docker-bake.hcl is its one source.
# A smaller variant of the image: the same stack and start script, without the
# LoRaWAN device repository, which is most of the upstream image. Devices are
# then added without picking them from the repository. Built with
# docker-bake.hcl, which sets the upstream version.

ARG UPSTREAM_VERSION
FROM thethingsnetwork/lorawan-stack:${UPSTREAM_VERSION} AS upstream

# An empty device repository index, so the stack starts without the repository.
USER root:root
RUN rm -rf /srv/ttn-lorawan/lorawan-devices-index && \
    mkdir -p data/lorawan-devices/vendor && \
    echo "vendors:" > data/lorawan-devices/vendor/index.yaml && \
    ttn-lw-stack dr-db init

# Same Alpine release as the upstream image the binaries come from.
FROM alpine:3.24

ARG VERSION=dev

RUN addgroup -g 886 thethings && adduser -u 886 -S -G thethings thethings

# curl for the health check. bash and envsubst run the start script, openssl
# creates the self-signed certificates, and jq builds the CLI credentials and the
# balena API requests.
RUN apk add --no-cache ca-certificates curl bash gettext-envsubst openssl jq

# The same layout as the upstream image.
COPY --from=upstream /bin/ttn-lw-stack /bin/ttn-lw-cli /bin/
COPY --from=upstream /srv/ttn-lorawan/lorawan-frequency-plans /srv/ttn-lorawan/lorawan-frequency-plans
COPY --from=upstream /srv/ttn-lorawan/lorawan-webhook-templates /srv/ttn-lorawan/lorawan-webhook-templates
COPY --from=upstream /data/lorawan-devices-index /srv/ttn-lorawan/lorawan-devices-index
COPY --from=upstream /srv/ttn-lorawan/public /srv/ttn-lorawan/public
RUN chmod -R 755 /srv/ttn-lorawan/lorawan-devices-index && \
    ln -s /bin/ttn-lw-stack /bin/stack && \
    ln -s /bin/ttn-lw-cli /bin/cli && \
    install -d -o thethings -g thethings /srv/ttn-lorawan/public/blob

# Certificates, keys and markers the start script keeps across restarts.
RUN install -d -o thethings -g thethings -m 0750 /srv/data
VOLUME ["/srv/data"]

WORKDIR /home/thethings
COPY runner/ ./
ENV PATH="${PATH}:/home/thethings" \
    IMAGE_VERSION=${VERSION}

# As in the upstream image.
EXPOSE 1700/udp 1881 8881 1882 8882 1883 8883 1884 8884 1885 8885 1887 8887
VOLUME ["/srv/ttn-lorawan/public/blob"]
ENV TTN_LW_HEALTHCHECK_URL=http://localhost:1885/healthz \
    XDG_CACHE_HOME=/home/thethings/.cache
HEALTHCHECK --interval=1m --timeout=5s CMD curl -f $TTN_LW_HEALTHCHECK_URL || exit 1

USER thethings:thethings

ENTRYPOINT ["bash", "start"]
