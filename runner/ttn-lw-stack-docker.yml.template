# The Things Stack configuration, written by the start script from environment
# variables on every start. Values in '...' come from user settings with any
# quote doubled; the start script validates the unquoted ones.

# Identity Server configuration
# Email configuration for "${TTS_DOMAIN}"
is:
  email:
    sender-name: '${TTS_SERVER_NAME_YAML}'
    sender-address: '${TTS_NOREPLY_EMAIL_YAML}'
    network:
      name: '${TTS_SERVER_NAME_YAML}'
      console-url: 'https://${TTS_DOMAIN}:${TTS_PORT}/console'
      identity-server-url: 'https://${TTS_DOMAIN}:${TTS_PORT}/oauth'

    provider: ${MAIL_PROVIDER}

    # If sending email with Sendgrid
    # provider: sendgrid
    sendgrid:
      api-key: '${TTS_SENDGRID_KEY_YAML}'

    # If sending email with SMTP
    # provider: smtp
    smtp:
      address:  '${TTS_SMTP_HOST_YAML}'
      username: '${TTS_SMTP_USER_YAML}'
      password: '${TTS_SMTP_PASS_YAML}'

  # Web UI configuration for "${TTS_DOMAIN}":
  oauth:
    ui:
      canonical-url: 'https://${TTS_DOMAIN}:${TTS_PORT}/oauth'
      is:
        base-url: 'https://${TTS_DOMAIN}:${TTS_PORT}/api/v3'

# HTTP server configuration
http:
  cookie:
    block-key: '${BLOCK_KEY}'
    hash-key: '${HASH_KEY}'
  metrics:
    password: '${TTS_METRICS_PASSWORD_YAML}'
  pprof:
    password: '${TTS_PPROF_PASSWORD_YAML}'

# If using custom certificates:
tls:
  source: file
  root-ca: ${DATA_FOLDER}/ca.pem
  certificate: ${DATA_FOLDER}/cert.pem
  key: ${DATA_FOLDER}/key.pem

# Let's encrypt for "${TTS_DOMAIN}"
#tls:
#  source: 'acme'
#  acme:
#    dir: '/var/lib/acme'
#    email: '<admin email>'
#    hosts: ['${TTS_DOMAIN}']
#    default-host: '${TTS_DOMAIN}'

# Network Server configuration
ns:
  net-id: '${TTS_NET_ID}'
  dev-addr-prefixes:
  - '${TTS_DEVADDR_RANGE}'

# If Gateway Server enabled, defaults for "${TTS_DOMAIN}":
gs:
  forward:
    cluster: ["00000000/0"]
    ${PB_FORWARDER_PREFIX}packetbroker : ["00000000/0"]
  mqtt:
    public-address: '${TTS_DOMAIN}:1882'
    public-tls-address: '${TTS_DOMAIN}:8882'
  mqtt-v2:
    public-address: '${TTS_DOMAIN}:1881'
    public-tls-address: '${TTS_DOMAIN}:8881'

# If Gateway Configuration Server enabled, defaults for "${TTS_DOMAIN}":
gcs:
  basic-station:
    default:
      lns-uri: 'wss://${TTS_DOMAIN}:8887'
  the-things-gateway:
    default:
      mqtt-server: 'mqtts://${TTS_DOMAIN}:8881'

# Web UI configuration for "${TTS_DOMAIN}":
console:
  ui:
    canonical-url: 'https://${TTS_DOMAIN}:${TTS_PORT}/console'
    is:
      base-url: 'https://${TTS_DOMAIN}:${TTS_PORT}/api/v3'
    gs:
      base-url: 'https://${TTS_DOMAIN}:${TTS_PORT}/api/v3'
    gcs:
      base-url: 'https://${TTS_DOMAIN}:${TTS_PORT}/api/v3'
    ns:
      base-url: 'https://${TTS_DOMAIN}:${TTS_PORT}/api/v3'
    as:
      base-url: 'https://${TTS_DOMAIN}:${TTS_PORT}/api/v3'
    js:
      base-url: 'https://${TTS_DOMAIN}:${TTS_PORT}/api/v3'
    qrg:
      base-url: 'https://${TTS_DOMAIN}:${TTS_PORT}/api/v3'
    edtc:
      base-url: 'https://${TTS_DOMAIN}:${TTS_PORT}/api/v3'
    dcs:
      base-url: 'https://${TTS_DOMAIN}:${TTS_PORT}/api/v3'

  oauth:
    authorize-url: 'https://${TTS_DOMAIN}:${TTS_PORT}/oauth/authorize'
    token-url: 'https://${TTS_DOMAIN}:${TTS_PORT}/oauth/token'
    logout-url: 'https://${TTS_DOMAIN}:${TTS_PORT}/oauth/logout'
    client-id: 'console'
    client-secret: '${TTS_CONSOLE_SECRET_YAML}'

# If Application Server enabled, defaults for "${TTS_DOMAIN}":
as:
  mqtt:
    public-address: '${TTS_DOMAIN}:1883'
    public-tls-address: '${TTS_DOMAIN}:8883'
  webhooks:
    downlink:
      public-address: '${TTS_DOMAIN}:1885/api/v3'

# If Device Claiming Server enabled, defaults for "${TTS_DOMAIN}":
dcs:
  oauth:
    authorize-url: 'https://${TTS_DOMAIN}:${TTS_PORT}/oauth/authorize'
    token-url: 'https://${TTS_DOMAIN}:${TTS_PORT}/oauth/token'
    logout-url: 'https://${TTS_DOMAIN}:${TTS_PORT}/oauth/logout'
    client-id: 'device-claiming'
    client-secret: '${TTS_DEVICE_CLAIMING_SECRET_YAML}'
  ui:
    canonical-url: 'https://${TTS_DOMAIN}:${TTS_PORT}/claim'
    as:
      base-url: 'https://${TTS_DOMAIN}:${TTS_PORT}/api/v3'
    dcs:
      base-url: 'https://${TTS_DOMAIN}:${TTS_PORT}/api/v3'
    is:
      base-url: 'https://${TTS_DOMAIN}:${TTS_PORT}/api/v3'
    ns:
      base-url: 'https://${TTS_DOMAIN}:${TTS_PORT}/api/v3'

# Packet Broker Agent configuration
pba:
  data-plane-address: '${PB_HOST_YAML}'
  net-id: '${TTS_NET_ID}'
  tenant-id: '${PB_TENANT_ID_YAML}'
  cluster-id: '${TTS_DOMAIN}'
  authentication-mode: 'oauth2'
  oauth2:
    client-id: '${PB_OAUTH_ID_YAML}'
    client-secret: '${PB_OAUTH_SECRET_YAML}'
  forwarder:
    enable: ${PB_FORWARDER_ENABLE}
    token-key: '${PB_TOKEN_KEY}'
  home-network:
    enable: ${PB_HOME_ENABLE}
